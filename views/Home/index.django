{% include "partials/header.django" %}
<div class="container py-3">
    <div class="p-5 mb-4 bg-light rounded-3">
        <div class="container-fluid py-5">
          <h1 class="display-5 fw-bold">{{APPNAME}}</h1>
          <p class="col-md-8 fs-4">A production-ready Go web application starter built on Fiber v2 with authentication, MySQL integration, and server-side rendering.</p>
          <a href="https://docs.gofiber.io/" class="btn btn-primary btn-lg" target="_blank">Fiber Documentation</a>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Authentication</h5>
                    <p class="card-text">User registration, login, session management, and protected routes with Argon2id password hashing.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Database Ready</h5>
                    <p class="card-text">MySQL integration with GORM ORM, repository pattern, and SQL-based migrations.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Security Built-In</h5>
                    <p class="card-text">CSRF protection, secure sessions, request ID tracking, and structured middleware stack.</p>
                </div>
            </div>
        </div>
    </div>
</div>

{% include "partials/footer.django" %}
